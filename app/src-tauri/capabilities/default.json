{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-focused",
    "core:tray:default",
    "core:webview:allow-set-webview-zoom",
    "window-state:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.planespotters.net" },
        { "url": "https://www.planespotters.net/*" },
        { "url": "https://github.com/unwritten-dev/*" },
        { "url": "https://docs.flightsimulator.com" },
        { "url": "https://docs.flightsimulator.com/*" },
        { "url": "https://cloudless.eox.at" },
        { "url": "https://cloudless.eox.at/*" },
        { "url": "https://www.rainviewer.com" },
        { "url": "https://www.rainviewer.com/*" },
        { "url": "https://view.eumetsat.int" },
        { "url": "https://view.eumetsat.int/*" },
        { "url": "https://openfreemap.org" },
        { "url": "https://openfreemap.org/*" },
        { "url": "https://www.openmaptiles.org" },
        { "url": "https://www.openmaptiles.org/*" },
        { "url": "https://www.openstreetmap.org" },
        { "url": "https://www.openstreetmap.org/*" },
        { "url": "https://maplibre.org" },
        { "url": "https://maplibre.org/*" },
        { "url": "http://127.0.0.1:[0-9]*/*" }
      ],
      "deny": [
        { "url": "http://*@*" },
        { "url": "https://*@*" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "log:default",
    "updater:default",
    "process:default",
    "notification:default"
  ]
}
