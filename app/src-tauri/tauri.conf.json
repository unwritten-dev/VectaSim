{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VectaSim",
  "version": "0.3.0",
  "identifier": "io.vectasim.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VectaSim",
        "width": 1100,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://tiles.openfreemap.org https://*.plnspttrs.net https://*.planespotters.net",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.openfreemap.org",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "VectaSim",
    "shortDescription": "Flight tracker and logbook for flight simulators",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCRTU0RUUwQ0ZFQzI4QkMKUldTOEtPelA0RTdsQzNXMjAyaGhYTm1SSHhDdDBMR0Y0SDdTNkhnSW0xRlFNcmZFU2loY3haY3QK",
      "endpoints": [
        "https://github.com/unwritten-dev/VectaSim/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
